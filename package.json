{
  "name": "nomad",
  "version": "1.0.0",
  "description": "2nomads' Framework for Jekyll Sites.",
  "main": "webpack.config.js",
  "scripts": {
    "watch:assets": "cross-env NODE_ENV=development webpack --watch --progress --config webpack.config.js",
    "build:assets": "cross-env NODE_ENV=production webpack --progress --config webpack.build.config.js",
    "build:site": "bundle exec jekyll build",
    "serve:site": "bundle exec jekyll serve --host 0.0.0.0 --port 4000 --livereload",
    "watch": "npm run watch:assets",
    "build": "npm run build:assets && npm run build:site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://ivanduch@bitbucket.org/2nomads/nomad-jk.git"
  },
  "author": "Ivan Duch",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@vue/compiler-sfc": "^3.5.13",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "vue-loader": "^17.4.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^5.1.4",
    "webpack-manifest-plugin": "^5.0.1"
  },
  "homepage": "https://bitbucket.org/2nomads/nomad-jk#readme",
  "dependencies": {
    "aos": "^2.2.0",
    "foundation-sites": "^6.8.1",
    "jump.js": "^1.0.2",
    "normalize.css": "^7.0.0",
    "rellax": "^1.3.0",
    "svg4everybody": "^2.1.9",
    "vue": "^3.5.13",
    "vuex": "^4.1.0"
  }
}
